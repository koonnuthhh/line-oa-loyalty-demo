DB_HOST=<your_db_host>
DB_PORT=<your_db_port>
DB_USERNAME=<your_db_username>
DB_PASSWORD=<your_db_password>
DB_NAME=<your_db_name>

# --- Optional demo mode (no database server needed) ---
# Set DB_MODE=demo to run with an in-memory SQLite database that is created and
# seeded automatically at boot. Great for a quick local demo or a free-tier host.
# Leave unset to use the PostgreSQL config above.
#DB_MODE=demo